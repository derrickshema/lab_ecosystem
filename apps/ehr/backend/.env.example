# Database connection
# Running on your machine (uvicorn/alembic from .venv): host is localhost.
# Inside docker-compose, the backend gets DATABASE_URL from docker-compose.yml
# instead, where the host is the service name 'postgres'.
# The server is shared and runs from infrastructure/docker-compose.yml (port 5433).
DATABASE_URL=postgresql+psycopg2://ehr_user:ehr_123@localhost:5433/ehr_db

# Authentication: tokens are issued by apps/identity; EHR only verifies them
IDENTITY_JWKS_URL=http://localhost:8002/.well-known/jwks.json

# Environment: "development" or "production"
# In production, cookies use Secure flag (HTTPS only)
ENVIRONMENT=development
DEBUG=True

# API Version
API_VERSION=v1
