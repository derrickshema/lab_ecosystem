# Database connection
# Running on your machine (uvicorn/alembic from .venv): host is localhost.
# Inside docker-compose, the backend gets DATABASE_URL from docker-compose.yml
# instead, where the host is the service name 'postgres'.
# The server is shared and runs from infrastructure/docker-compose.yml (port 5433).
DATABASE_URL=postgresql+psycopg2://ehr_user:ehr_123@localhost:5433/ehr_db

# Security - CHANGE THESE IN PRODUCTION!
# Generate SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment: "development" or "production"
# In production, cookies use Secure flag (HTTPS only)
ENVIRONMENT=development
DEBUG=True

# API Version
API_VERSION=v1

# Superadmin credentials (for initial setup only)
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=change-this-password
SUPERADMIN_EMAIL=admin@yourcompany.com