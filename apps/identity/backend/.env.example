# Database connection
# Running on your machine (uvicorn/alembic from .venv): host is localhost.
# Inside docker-compose, the backend gets DATABASE_URL from docker-compose.yml
# instead, where the host is the service name 'postgres'.
# The server is shared and runs from infrastructure/docker-compose.yml (port 5433).
DATABASE_URL=postgresql+psycopg2://identity_user:identity_123@localhost:5433/identity_db

# JWT signing keys (RS256). Generate with: python -m scripts.generate_jwt_keys
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_KEY_ID=identity-dev-1

DEBUG=True
FRONTEND_URL=http://localhost:5173

# First admin account, created by: python -m scripts.create_superadmin
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=change-this-password
SUPERADMIN_EMAIL=admin@yourcompany.com

# Email (optional in dev: without a key, emails are logged instead of sent)
RESEND_API_KEY=
